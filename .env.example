# Copy this file to .env and fill in the key(s) you want to use.
# .env is loaded automatically by config.py -- no extra setup needed.
# Only set the ones for the provider(s) you actually use.

# --- Groq (recommended: free tier, fast, cloud) ---
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional: override the default Groq model
# GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (fully offline, local) ---
# Only needed if you're forcing T2SQL_PROVIDER=ollama or don't set a Groq key.
# No key required -- just install Ollama and pull a model.
# OLLAMA_MODEL=llama3.1:8b
# OLLAMA_HOST=http://localhost:11434

# --- Anthropic (paid) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Force a specific provider instead of auto-detecting ---
# Leave unset (or "auto") to use the priority order: groq -> ollama -> anthropic
# T2SQL_PROVIDER=groq
